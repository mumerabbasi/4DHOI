# 4DHOI - Git ignore rules
# Keep source code, notebooks, and selection manifests trackable.

## OS / Editor
.DS_Store
Thumbs.db
._*
__MACOSX/
*~
*.swp
*.swo
.vscode/
.idea/
*.code-workspace

## Python cache / build artifacts
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

## Virtual environments and local config
.env
.env.*
.venv/
venv/
env/
ENV/
.python-version

## Logs
*.log

## Experiment/runtime directories
/checkpoints/
/logs/
/runs/
/wandb/
/first_frames/
/generated_videos/

## Local dataset payload (do not commit raw ScanNet++ data)
/data/

## Export artifacts
# Keep manifest files (.csv/.json) under outputs/selected_scenes_export,
# but ignore copied scene assets and compressed bundles.
/outputs/selected_scenes_export/scenes/
/outputs/selected_scenes_export/representative_images/
/outputs/*.tar.gz
/outputs/**/*.tar.gz

## Large model weights / binaries
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.safetensors
